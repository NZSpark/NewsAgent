# ==== Storage ====
NEWSAGENT_DB_PATH=data/newsagent.db

# ==== Fetch ====
NEWSAGENT_FETCH_TIMEOUT=15
NEWSAGENT_FETCH_CONCURRENCY=6
NEWSAGENT_FETCH_RETRIES=2
NEWSAGENT_USER_AGENT=NewsAgent/0.1 (+https://github.com/onetreehill/NewsAgent)
JINA_API_KEY=

# ==== Sites registry ====
NEWSAGENT_SITES_MD=doc/sites.md

# ==== Local LLM Providers (see doc/local_llm.md) ====
# Fallback order is comma-separated, left = highest priority
LLM_PROVIDERS=deepseek-web,gemini-web,chatgpt-web
DEEPSEEK_WEB_BASE_URL=http://127.0.0.1:8000/v1
GEMINI_WEB_BASE_URL=http://127.0.0.1:8001/v1
CHATGPT_WEB_BASE_URL=http://127.0.0.1:8002/v1
DEEPSEEK_WEB_MODEL=deepseek-chat
GEMINI_WEB_MODEL=gemini-chat
CHATGPT_WEB_MODEL=chatgpt-chat
LLM_TIMEOUT=120
# Per-provider override for slow Web backends (chatgpt-web can exceed 120s)
DEEPSEEK_WEB_TIMEOUT=120
GEMINI_WEB_TIMEOUT=120
CHATGPT_WEB_TIMEOUT=300
LLM_MAX_RETRIES=1
LLM_CONCURRENCY=3

# ==== Scheduler intervals (minutes) ====
NEWSAGENT_INTERVAL_OFFICIAL=30
NEWSAGENT_INTERVAL_MEDIA=60
NEWSAGENT_INTERVAL_COMMUNITY=60
NEWSAGENT_INTERVAL_RESEARCH=180
NEWSAGENT_INTERVAL_NEWSLETTER=720

# ==== Logging ====
NEWSAGENT_LOG_LEVEL=INFO
